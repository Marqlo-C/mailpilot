{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/renew-watch",
      "schedule": "0 4 * * *"
    }
  ],
  "routes": [
    {
      "src": "^/(login|api/auth/.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(curl|wget|python|postman|axios|go-http-client).*"
        }
      ],
      "continue": true,
      "mitigate": {
        "action": "deny"
      }
    }
  ]
}