{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/renew-watch",
      "schedule": "0 4 * * *"
    }
  ],
  "security": {
    "waf": {
      "rules": [
        {
          "name": "Challenge unverified bots on auth endpoints",
          "action": "challenge",
          "condition": {
            "all": [
              {
                "path": "^/(login|api/auth/.*)"
              },
              {
                "isBot": true
              }
            ]
          }
        }
      ]
    }
  }
}
