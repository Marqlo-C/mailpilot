# MailPilot Environment Variables

# PostgreSQL (Neon / Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# AES-256-GCM token encryption key (64-char hex = 32 bytes)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# Gmail Pub/Sub push topic (projects/{project-id}/topics/{topic-name})
GMAIL_PUBSUB_TOPIC=""

# Pub/Sub webhook secret
GMAIL_WEBHOOK_SECRET=""

# OpenRouter (LLM fallback)
OPENROUTER_API_KEY=""
# Optional. Tried first when set; otherwise the built-in model list is used.
# OPENROUTER_MODEL=""
# Optional site URL sent with OpenRouter requests. Defaults to https://mailpilot.local
# OPENROUTER_SITE_URL=""

# Local Ollama. Development always uses OLLAMA_BASE_URL.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# Optional model override. Defaults to llama3.1:8b
# OLLAMA_MODEL="llama3.1:8b"
# Optional. Set to true to allow OpenRouter after a local Ollama failure.
# OLLAMA_ALLOW_OPENROUTER_FALLBACK="false"

# Optional GitHub token for higher rate limits when syncing repos
GITHUB_TOKEN=""

# Public app origin for links in email. APP_URL and NEXTAUTH_URL are accepted aliases.
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# APP_URL="http://localhost:3000"
# NEXTAUTH_URL="http://localhost:3000"

# Cron secret for watch renewal
CRON_SECRET=""

# Logging (Pino) — optional override: fatal|error|warn|info|debug|trace|silent
# Defaults: production=warn, preview/development=debug, test=silent
# LOG_LEVEL="debug"
# LOG_PRETTY="0"  # set to 0 to disable pino-pretty in local next dev
