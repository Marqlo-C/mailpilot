# MailPilot Environment Variables

# PostgreSQL (Neon / Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# AES-256-GCM token encryption key (64-char hex = 32 bytes)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# Gmail Pub/Sub push topic (projects/{project-id}/topics/{topic-name})
GMAIL_PUBSUB_TOPIC=""

# Pub/Sub webhook secret
GMAIL_WEBHOOK_SECRET=""

# OpenRouter (LLM fallback)
OPENROUTER_API_KEY=""

# Cron secret for watch renewal
CRON_SECRET=""
