# ==============================================================================
# MailPilot Environment Configuration & Secret Inventory
# ==============================================================================
# Use this template to configure your local (.env.local) or deployment environment.
# NEVER commit plaintext credentials or live keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & CORE ENCRYPTION
# ------------------------------------------------------------------------------
# Purpose: Connection string for PostgreSQL (Neon, Supabase, or self-hosted) via Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Requirement: Required
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mailpilot?sslmode=prefer"

# Purpose: AES-256-GCM symmetric master key (32 bytes = 64-char hex) used to encrypt
#          and decrypt OAuth tokens, cloud LLM keys, and scraping credentials in PostgreSQL.
# Generate via: openssl rand -hex 32
# Requirement: Required
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH & GMAIL PUB/SUB
# ------------------------------------------------------------------------------
# Purpose: Google Cloud Console OAuth 2.0 Web Client ID for user sign-in and Gmail scopes.
# Format: {id}.apps.googleusercontent.com
# Requirement: Required
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Purpose: Google Cloud Console OAuth 2.0 Client Secret.
# Format: GOCSPX-...
# Requirement: Required
GOOGLE_CLIENT_SECRET="GOCSPX-yourClientSecretHere123456"

# Purpose: Authorized OAuth 2.0 redirect URI registered in Google Cloud Console.
# Format: http(s)://{host}/api/auth/callback/google
# Requirement: Required
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# Purpose: Cloud Pub/Sub topic resource for real-time Gmail push notification delivery.
# Format: projects/{project-id}/topics/{topic-name}
# Requirement: Required
GMAIL_PUBSUB_TOPIC="projects/mailpilot-app/topics/gmail-inbox-watch"

# Purpose: Webhook authorization token or secret matching incoming Google Pub/Sub push requests.
# Format: Random alphanumeric string
# Requirement: Required
GMAIL_WEBHOOK_SECRET="whsec_mailpilot_pubsub_webhook_secret_key"

# ------------------------------------------------------------------------------
# 3. SCHEDULED AUTOMATIONS & CRON
# ------------------------------------------------------------------------------
# Purpose: Bearer secret authorizing Vercel Cron or external dispatchers to trigger
#          periodic watch renewals (/api/cron/renew-watch) and background syncs (/api/cron/sync).
# Format: Random alphanumeric string
# Requirement: Required (in production)
CRON_SECRET="cron_sec_mailpilot_scheduled_task_token"

# ------------------------------------------------------------------------------
# 4. DISTRIBUTED RATE LIMITING (UPSTASH REDIS)
# ------------------------------------------------------------------------------
# Purpose: Upstash Redis REST endpoint for distributed rate limiting on public and auth endpoints.
# Format: https://{name}.upstash.io
# Requirement: Optional - Recommended (falls back to in-memory sliding window when omitted)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"

# Purpose: Upstash Redis REST access token.
# Format: Bearer token string
# Requirement: Optional - Recommended
UPSTASH_REDIS_REST_TOKEN="AX...UpstashRestToken=="

# ------------------------------------------------------------------------------
# 5. AI ENGINES & MODEL INGESTION (LOCAL OLLAMA & CLOUD BYOK)
# ------------------------------------------------------------------------------
# Note: In MailPilot, cloud LLM keys (OpenRouter, OpenAI, Anthropic, Gemini, Groq)
# are securely stored per-user in PostgreSQL via Settings → AI & Models (BYOK).
# The variables below are for local Ollama and server-wide developer fallbacks.

# Purpose: HTTP address for the local or remote Ollama daemon.
# Format: http://{host}:{port}
# Requirement: Optional - Self-Hosted / Development (defaults to http://127.0.0.1:11434)
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Purpose: Default Ollama model tag for parsing, classification, and resume tailoring.
# Format: Model tag string
# Requirement: Optional - Override (defaults to llama3.1:8b)
OLLAMA_MODEL="llama3.1:8b"

# Purpose: Fall back to cloud OpenRouter when local Ollama is unreachable or times out.
# Format: "true" | "false"
# Requirement: Optional - Development Only (defaults to false)
OLLAMA_ALLOW_OPENROUTER_FALLBACK="false"

# Purpose: Global OpenRouter API key fallback for development, testing, and CI pipelines.
# Format: sk-or-v1-...
# Requirement: Optional - BYOK / Dev Fallback
OPENROUTER_API_KEY=""

# Purpose: Optional app attribution URL sent in OpenRouter request headers.
# Format: https://...
# Requirement: Optional - Telemetry
OPENROUTER_SITE_URL="https://mailpilot.local"

# ------------------------------------------------------------------------------
# 6. EXTERNAL SCRAPING & PORTFOLIO ENGINES (BYOK & FALLBACKS)
# ------------------------------------------------------------------------------
# Purpose: GitHub personal access token to lift API rate limits (from 60/hr to 5,000/hr)
#          when ingesting portfolio repositories and parsing README/code structures.
# Format: ghp_... or github_pat_...
# Requirement: Optional - BYOK
GITHUB_TOKEN=""

# Purpose: Fallback key for ScrapingAnt headless browser proxy (anti-bot bypass for job links).
#          Primary storage is per-account via Settings → Scraping & Integrations.
# Format: ant-...
# Requirement: Optional - BYOK
SCRAPINGANT_API_KEY=""

# Purpose: Fallback key for HasData job search and company scraping engine.
#          Primary storage is per-account via Settings → Scraping & Integrations.
# Format: hd-...
# Requirement: Optional - BYOK / Dev Testing
HASDATA_API_KEY=""

# Purpose: Fallback key for Jina AI Reader / Search API for link context extraction.
#          Primary storage is per-account via Settings → Scraping & Integrations.
# Format: jina_...
# Requirement: Optional - BYOK
JINA_API_KEY=""

# ------------------------------------------------------------------------------
# 7. APPLICATION URLS & MULTI-TENANT BRANDING
# ------------------------------------------------------------------------------
# Purpose: Canonical public web origin for generating email links, digest anchors, and extension pairing.
# Format: http(s)://{domain}
# Requirement: Required (defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Purpose: Public app origin alias accepted by email and digest generators.
# Format: http(s)://{domain}
# Requirement: Optional - Alias
APP_URL="http://localhost:3000"

# Purpose: NextAuth-compatible base URL alias.
# Format: http(s)://{domain}
# Requirement: Optional - Alias
NEXTAUTH_URL="http://localhost:3000"

# Purpose: Custom GitHub developer/author profile link displayed in header/footer navigation.
# Format: https://github.com/{username}
# Requirement: Optional - Branding (defaults to https://github.com)
NEXT_PUBLIC_DEVELOPER_GITHUB_URL="https://github.com"

# Purpose: Repository source code link displayed in application brand marks and dialogs.
# Format: https://github.com/{org}/{repo}
# Requirement: Optional - Branding (defaults to https://github.com/mailpilot/mailpilot)
NEXT_PUBLIC_REPOSITORY_URL="https://github.com/mailpilot/mailpilot"

# Purpose: Target backend origin override used when bundling the Chrome Extension.
# Format: http(s)://{host}:{port}
# Requirement: Optional - Development Only
TARGET_HOST="http://localhost:3000"

# ------------------------------------------------------------------------------
# 8. CLOUD STORAGE & MEDIA ASSETS (VERCEL BLOB)
# ------------------------------------------------------------------------------
# Purpose: Read/write token for Vercel Blob store (used for login video streaming).
# Format: vercel_blob_rw_...
# Requirement: Optional - Cloud Storage (falls back to local public video assets)
BLOB_READ_WRITE_TOKEN=""

# Purpose: Custom blob path/filename for login background video.
# Format: filename or subpath string
# Requirement: Optional - Asset Override (defaults to color-spin-fast.mp4)
LOGIN_BG_BLOB_PATH="color-spin-fast.mp4"

# Purpose: Custom blob path/filename for login background video poster image.
# Format: filename or subpath string
# Requirement: Optional - Asset Override (defaults to color-spin-poster.webp)
LOGIN_POSTER_BLOB_PATH="color-spin-poster.webp"

# ------------------------------------------------------------------------------
# 9. TELEMETRY, DIAGNOSTICS & STRUCTURED LOGGING
# ------------------------------------------------------------------------------
# Purpose: Minimum Pino logging threshold: fatal | error | warn | info | debug | trace | silent.
# Requirement: Optional - Defaults: production=warn, preview/dev=debug, test=silent
LOG_LEVEL="debug"

# Purpose: Disable pino-pretty terminal formatting in local development by setting to "0".
# Requirement: Optional - Development Only
LOG_PRETTY="1"

# Purpose: Enable or disable formatted ASCII table outputs in sync and classification logs.
# Format: "1" (force on) | "0" (force off) | omitted (auto: on in dev, off in prod/test)
# Requirement: Optional - Telemetry
LOG_ASCII_TABLES="1"

# Purpose: Enable high-frequency debug output during classification, token calculation, and testing.
# Format: "1" (active) | unset (inactive)
# Requirement: Optional - Diagnostics
DEBUG_VERBOSE="0"
