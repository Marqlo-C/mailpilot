<file path="prisma/schema.prisma">
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Durable identity that survives Gmail credential unlink / re-link.
model PersistentProfile {
  id        String   @id @default(cuid())
  /// Google OpenID `sub`, or sha256(email) fallback when sub is unavailable.
  googleSub String   @unique
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts            Account[]
  permanentSettings   PermanentSettings?
  jobApplications     JobApplication[]
  subscriptionHistory SubscriptionHistory[]

  @@index([email])
}

/// Job Radar automation knobs that persist with the profile (not credentials).
model PermanentSettings {
  id                  String            @id @default(cuid())
  persistentProfileId String            @unique
  persistentProfile   PersistentProfile @relation(fields: [persistentProfileId], references: [id], onDelete: Cascade)

  // "MANUAL_REVIEW" | "AUTO_SEND"
  applicationMode     String @default("MANUAL_REVIEW")
  matchScoreThreshold Int    @default(75)
  maxAutoSendsPerDay  Int    @default(5)

  updatedAt DateTime @updatedAt
}

/// Archive of past unsubscribe / ignore decisions keyed to the durable profile.
model SubscriptionHistory {
  id            String            @id @default(cuid())
  userProfileId String
  userProfile   PersistentProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  senderEmail String
  senderName  String?
  // "UNSUBSCRIBED" | "IGNORED"
  status      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userProfileId, senderEmail])
  @@index([userProfileId, status])
}

model Account {
  id                  String             @id @default(cuid())
  email               String             @unique
  /// Nullable so "Unlink Gmail" can clear credentials without deleting history.
  encryptedAccess     String?
  encryptedRefresh    String?
  tokenExpiry         DateTime?
  historyId           String?
  isActive            Boolean            @default(true)
  persistentProfileId String?
  persistentProfile   PersistentProfile? @relation(fields: [persistentProfileId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  /// Background inbox scan / sync tracking
  isSyncing           Boolean            @default(false)
  lastSyncedAt        DateTime?
  syncError           String?
  /// Opportunities upserted on the most recent completed sync (for UI toast).
  lastSyncProcessed   Int?
  /// Touched by the background worker each batch so hang detection uses liveness, not lock start.
  syncHeartbeatAt     DateTime?

  settings        AccountSettings?
  subscriptions   Subscription[]
  jobApplications JobApplication[]
  emailMessages   EmailMessage[]
  jobOpportunities JobOpportunity[]
  profile         UserProfile?
  /// Single most-recent briefing for this inbox (older digests live in client localStorage).
  latestBriefing  SubscriptionBriefing?

  @@index([email])
  @@index([persistentProfileId])
}

/// Exactly one row per account: the most recently generated briefing digest.
model SubscriptionBriefing {
  id               String   @id @default(cuid())
  accountId        String   @unique
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Gmail subject, e.g. "Mail Pilot Snapshot · 8 updates · Jul 31 – Aug 7, 2026".
  subject          String?
  htmlPreview      String   @db.Text
  generatedAt      DateTime
  /// Lowercased sender emails included in this digest.
  senderEmails     String[]
  /// Subscription ids included (for badge matching + localStorage migration).
  subscriptionIds  String[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AccountSettings {
  id             String  @id @default(cuid())
  accountId      String  @unique
  account        Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  llmProvider    String  @default("OPENROUTER") // "OPENROUTER" | "LOCAL_OLLAMA"
  localOllamaUrl String? @default("http://localhost:11434")
  ollamaModel    String? @default("llama3.1:8b")

  // Dynamic rules validated via Zod schema (accountRulesSchema)
  rules          Json    @default("{}")

  updatedAt DateTime @updatedAt
}

model Subscription {
  id             String    @id @default(cuid())
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  senderName     String?
  senderEmail    String
  unsubHttpUrl   String?
  unsubPostUrl   String?
  unsubPostBody  String?
  unsubMailto    String?
  status         String    @default("ACTIVE") // "ACTIVE" | "UNSUBSCRIBED" | "FAILED"
  /// Tracked volume (newsletter message count) for this sender.
  emailCount     Int       @default(1)
  /// Cached clutter 0–100 (recomputed when volume changes, e.g. after briefing trash).
  clutterScore   Int       @default(0)
  lastReceivedAt DateTime?
  /// Last unsubscribe/cleanup error for UI hover (cleared on success).
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, senderEmail])
  @@index([accountId, status])
}

/// Parent Gmail message that may yield zero or many JobOpportunity rows.
model EmailMessage {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  messageId   String
  threadId    String
  subject     String?
  fromEmail   String?
  fromName    String?
  /// DIRECT_RECRUITER | JOB_BOARD_DIGEST | APPLICATION_STATUS | IRRELEVANT
  emailCategory String @default("IRRELEVANT")
  emailDate   DateTime
  /// Short cleaned preview for list UI.
  snippet     String?  @db.Text
  /// Full original extracted body (plain/html text from Gmail) for drafting.
  rawBody     String?  @db.Text

  opportunities JobOpportunity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, messageId])
  @@index([accountId, emailCategory])
  @@index([accountId, emailDate])
}

/// Extracted job posting from a recruiter email or job-board digest.
model JobOpportunity {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  emailMessageId  String?
  emailMessage    EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)

  company         String
  /// Inferred website domain for zero-token favicon lookup (e.g. "stripe.com").
  companyDomain   String?
  /// Computed favicon / logo URL (Google S2 or Unavatar).
  logoUrl         String?
  title           String
  location        String?
  /// Display string (e.g. "$115,000 - $130,000/yr" or "$55/hr").
  salary          String?
  /// Normalized annualized max for numerical sorting (hourly × 2080 when needed).
  salaryMax       Float?
  /// Relative listing age when present (e.g. "2 days ago", "Just posted").
  postedAt        String?
  /// Gmail message internalDate (when the email was received).
  receivedAt      DateTime @default(now())
  description     String?  @db.Text
  /// Full tracking / direct application link (may be long aggregator URLs).
  applyUrl        String?  @db.Text
  /// DIRECT_EMAIL | EXTERNAL_LINK | QUICK_APPLY
  applicationType String   @default("EXTERNAL_LINK")
  /// Must be null when no direct recruiter contact exists (no email drafts allowed).
  recipientEmail  String?
  recipientName   String?
  draftSubject    String?
  draftBody       String?  @db.Text
  /// DISCOVERED | REVIEW_READY | APPLIED | DISMISSED
  status          String   @default("DISCOVERED")
  /// Preserves category before user archive/dismiss so Restore can return cleanly.
  previousStatus  String?
  /// When the candidate applied (email confirmation date or manual mark).
  appliedAt       DateTime?
  /// 0–100 fit vs candidate profile; below threshold → isArchived (when not user-archived).
  matchScore      Int      @default(0)
  /// One-sentence AI verdict of fit / mismatch.
  matchReason     String?  @db.Text
  /// Below-threshold soft-hide, OR user-archived (when previousStatus is set).
  isArchived      Boolean  @default(false)
  /// Set when status becomes DISMISSED; auto-purged after retention window.
  dismissedAt     DateTime?

  /// Cached tailored resume PDF (base64). Null until the user generates one.
  tailoredResumePdf  String?   @db.Text
  /// Cached tailor payload (summary, skills, experience, projects, rationale).
  tailoredResumeData Json?
  /// When the tailored resume was last generated or refined.
  tailoredAt         DateTime?
  /// Config used for the cached resume (e.g. `{ includeSummary: boolean }`).
  tailorConfig       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, status])
  @@index([accountId, applicationType])
  @@index([accountId, isArchived])
  @@index([emailMessageId])
  @@index([accountId, createdAt])
  @@index([accountId, matchScore])
  @@index([accountId, receivedAt])
  @@index([accountId, salaryMax])
  @@index([dismissedAt])
}

model JobApplication {
  id                  String             @id @default(cuid())
  /// Optional link to live Gmail credentials; cleared if account row is removed.
  accountId           String?
  account             Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// Durable owner — survives credential unlink.
  persistentProfileId String?
  persistentProfile   PersistentProfile? @relation(fields: [persistentProfileId], references: [id], onDelete: SetNull)

  messageId String
  threadId  String
  companyName String?
  roleTitle   String?
  // "LEAD" | "APPLIED" | "OA" | "INTERVIEW" | "OFFER" | "REJECTION" | "ARCHIVED"
  status         String    @default("LEAD")
  // "EMAIL" | "PORTAL" (legacy mirror of applicationMethod)
  dispatchType   String    @default("EMAIL")
  // "PENDING_REVIEW" | "SENT" | "MANUAL_APPLIED"
  dispatchStatus String    @default("PENDING_REVIEW")
  /// Draft pipeline: DETECTED | DRAFT_PREPARED | DRAFT_SAVED_GMAIL | SENT | DISMISSED
  opportunityStatus String @default("DETECTED")
  /// DIRECT_EMAIL | EXTERNAL_LINK | PORTAL_QUICK_APPLY
  applicationMethod String @default("DIRECT_EMAIL")
  applyUrl          String?
  draftSubject      String?
  draftBody         String?  @db.Text
  gmailDraftId      String?
  gmailMessageId    String?
  appliedAt      DateTime?
  sentAt         DateTime?
  matchScore     Int?
  matchRationale String?
  // { selectedBullets: string[], coverLetter: string, jobRequirements: string[] }
  tailoredData   Json?

  actionRequired Boolean   @default(false)
  actionSummary  String?
  actionUrl      String?
  deadlineAt     DateTime?
  emailDate      DateTime
  isTrashed      Boolean   @default(false)
  isArchived     Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, messageId])
  @@index([persistentProfileId, messageId])
  @@index([accountId, status])
  @@index([persistentProfileId, status])
  @@index([accountId, companyName])
  @@index([accountId, opportunityStatus])
  @@index([actionRequired])
}

model UserProfile {
  id        String  @id @default(cuid())
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  fullName String
  email    String
  phone    String?
  location String?
  summary  String?
  // [{ label: string, url: string }]
  links    Json    @default("[]")
  // { languages: string[], frameworks: string[], tools: string[], concepts: string[] }
  skills   Json    @default("{}")

  matchThreshold  Int     @default(75)

  linkedWebsite   String?
  linkedIndeed    String?
  linkedGlassdoor String?
  linkedGithub    String?
  linkedLinkedin  String?
  linkedHandshake String?

  /// Cached career-stage persona (recomputed on master profile save)
  seniorityTier   String?
  timelineContext  String?
  toneGuidance     String?

  experiences WorkExperience[]
  projects    Project[]
  education   Education[]
  history     ProfileHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProfileHistory {
  id        String      @id @default(cuid())
  profileId String
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// e.g. "Before GitHub Sync", "Before Resume Extraction", "Manual Edit"
  summary   String
  /// Complete MasterProfileInput JSON snapshot
  snapshot  Json
  createdAt DateTime    @default(now())

  @@index([profileId, createdAt])
}

model WorkExperience {
  id        String      @id @default(cuid())
  profileId String
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  company      String
  role         String
  location     String?
  startDate    String
  endDate      String?
  // [{ id: string, rawText: string, technologies: string[], hasMetric: boolean }]
  bullets      Json
  displayOrder Int      @default(0)
}

model Project {
  id           String      @id @default(cuid())
  profileId    String
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name         String
  description  String
  technologies String[]
  link         String?
  bullets      String[]
}

model Education {
  id             String      @id @default(cuid())
  profileId      String
  profile        UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  institution    String
  degree         String
  fieldOfStudy   String?
  graduationDate String?
}
