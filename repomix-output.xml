<file path="prisma/schema.prisma">
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Durable identity that survives Gmail credential unlink / re-link.
model PersistentProfile {
  id        String   @id @default(cuid())
  /// Google OpenID `sub`, or sha256(email) fallback when sub is unavailable.
  googleSub String   @unique
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts            Account[]
  permanentSettings   PermanentSettings?
  jobApplications     JobApplication[]
  subscriptionHistory SubscriptionHistory[]

  @@index([email])
}

/// Job Radar automation knobs that persist with the profile (not credentials).
model PermanentSettings {
  id                  String            @id @default(cuid())
  persistentProfileId String            @unique
  persistentProfile   PersistentProfile @relation(fields: [persistentProfileId], references: [id], onDelete: Cascade)

  // "MANUAL_REVIEW" | "AUTO_SEND"
  applicationMode     String @default("MANUAL_REVIEW")
  matchScoreThreshold Int    @default(75)
  maxAutoSendsPerDay  Int    @default(5)

  updatedAt DateTime @updatedAt
}

/// Archive of past unsubscribe / ignore decisions keyed to the durable profile.
model SubscriptionHistory {
  id            String            @id @default(cuid())
  userProfileId String
  userProfile   PersistentProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  senderEmail String
  senderName  String?
  // "UNSUBSCRIBED" | "IGNORED"
  status      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userProfileId, senderEmail])
  @@index([userProfileId, status])
}

model Account {
  id                  String             @id @default(cuid())
  email               String             @unique
  /// Nullable so "Unlink Gmail" can clear credentials without deleting history.
  encryptedAccess     String?
  encryptedRefresh    String?
  tokenExpiry         DateTime?
  historyId           String?
  isActive            Boolean            @default(true)
  persistentProfileId String?
  persistentProfile   PersistentProfile? @relation(fields: [persistentProfileId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  /// Background inbox scan / sync tracking
  isSyncing           Boolean            @default(false)
  lastSyncedAt        DateTime?
  syncError           String?
  /// Opportunities upserted on the most recent completed sync (for UI toast).
  lastSyncProcessed   Int?

  settings        AccountSettings?
  subscriptions   Subscription[]
  jobApplications JobApplication[]
  emailMessages   EmailMessage[]
  jobOpportunities JobOpportunity[]
  profile         UserProfile?

  @@index([email])
  @@index([persistentProfileId])
}

model AccountSettings {
  id             String  @id @default(cuid())
  accountId      String  @unique
  account        Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  llmProvider    String  @default("OPENROUTER") // "OPENROUTER" | "LOCAL_OLLAMA"
  localOllamaUrl String? @default("http://localhost:11434")
  ollamaModel    String? @default("llama3.1:8b")

  // Dynamic rules validated via Zod schema (accountRulesSchema)
  rules          Json    @default("{}")

  updatedAt DateTime @updatedAt
}

model Subscription {
  id             String    @id @default(cuid())
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  senderName     String?
  senderEmail    String
  unsubHttpUrl   String?
  unsubPostUrl   String?
  unsubPostBody  String?
  unsubMailto    String?
  status         String    @default("ACTIVE") // "ACTIVE" | "UNSUBSCRIBED" | "FAILED"
  emailCount     Int       @default(1)
  lastReceivedAt DateTime?
  /// Last unsubscribe/cleanup error for UI hover (cleared on success).
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, senderEmail])
  @@index([accountId, status])
}

/// Parent Gmail message that may yield zero or many JobOpportunity rows.
model EmailMessage {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  messageId   String
  threadId    String
  subject     String?
  fromEmail   String?
  fromName    String?
  /// DIRECT_RECRUITER | JOB_BOARD_DIGEST | APPLICATION_STATUS | IRRELEVANT
  emailCategory String @default("IRRELEVANT")
  emailDate   DateTime
  snippet     String?  @db.Text

  opportunities JobOpportunity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, messageId])
  @@index([accountId, emailCategory])
  @@index([accountId, emailDate])
}

/// Extracted job posting from a recruiter email or job-board digest.
model JobOpportunity {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  emailMessageId  String?
  emailMessage    EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)

  company         String
  /// Inferred website domain for zero-token favicon lookup (e.g. "stripe.com").
  companyDomain   String?
  /// Computed favicon / logo URL (Google S2 or Unavatar).
  logoUrl         String?
  title           String
  location        String?
  /// Display string (e.g. "$115,000 - $130,000/yr" or "$55/hr").
  salary          String?
  /// Normalized annualized max for numerical sorting (hourly × 2080 when needed).
  salaryMax       Float?
  /// Relative listing age when present (e.g. "2 days ago", "Just posted").
  postedAt        String?
  /// Gmail message internalDate (when the email was received).
  receivedAt      DateTime @default(now())
  description     String?  @db.Text
  /// Full tracking / direct application link (may be long aggregator URLs).
  applyUrl        String?  @db.Text
  /// DIRECT_EMAIL | EXTERNAL_LINK | QUICK_APPLY
  applicationType String   @default("EXTERNAL_LINK")
  /// Must be null when no direct recruiter contact exists (no email drafts allowed).
  recipientEmail  String?
  recipientName   String?
  draftSubject    String?
  draftBody       String?  @db.Text
  /// DISCOVERED | REVIEW_READY | APPLIED | DISMISSED
  status          String   @default("DISCOVERED")
  /// Preserves category before user archive/dismiss so Restore can return cleanly.
  previousStatus  String?
  /// When the candidate applied (email confirmation date or manual mark).
  appliedAt       DateTime?
  /// 0–100 fit vs candidate profile; below threshold → isArchived (when not user-archived).
  matchScore      Int      @default(0)
  /// One-sentence AI verdict of fit / mismatch.
  matchReason     String?  @db.Text
  /// Below-threshold soft-hide, OR user-archived (when previousStatus is set).
  isArchived      Boolean  @default(false)
  /// Set when status becomes DISMISSED; auto-purged after retention window.
  dismissedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, status])
  @@index([accountId, applicationType])
  @@index([accountId, isArchived])
  @@index([emailMessageId])
  @@index([accountId, createdAt])
  @@index([accountId, matchScore])
  @@index([accountId, receivedAt])
  @@index([accountId, salaryMax])
  @@index([dismissedAt])
}

model JobApplication {
