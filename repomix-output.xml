  roleTitle   String?
  // "LEAD" | "APPLIED" | "OA" | "INTERVIEW" | "OFFER" | "REJECTION" | "ARCHIVED"
  status         String    @default("LEAD")
  // "EMAIL" | "PORTAL" (legacy mirror of applicationMethod)
  dispatchType   String    @default("EMAIL")
  // "PENDING_REVIEW" | "SENT" | "MANUAL_APPLIED"
  dispatchStatus String    @default("PENDING_REVIEW")
  /// Draft pipeline: DETECTED | DRAFT_PREPARED | DRAFT_SAVED_GMAIL | SENT | DISMISSED
