] as const;

export type ApplicationStatus = (typeof APPLICATION_STATUSES)[number];

export const OPPORTUNITY_STATUSES = [
  "DETECTED",
  "DRAFT_PREPARED",
  "DRAFT_SAVED_GMAIL",
  "SENT",
  "DISMISSED",
] as const;

export type OpportunityStatus = (typeof OPPORTUNITY_STATUSES)[number];

export const APPLICATION_METHODS = [
  "DIRECT_EMAIL",
  "EXTERNAL_LINK",
  "PORTAL_QUICK_APPLY",
] as const;

