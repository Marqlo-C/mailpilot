/**
 * Zero-cost geographic normalizer and compatibility matcher.
 * Resolves variations like "Sacramento, CA", "Sacramento", and "Sacramento, California".
 */

const US_STATES_AND_TERRITORIES: Record<string, string> = {
  alabama: "AL",
  alaska: "AK",
  arizona: "AZ",
  arkansas: "AR",
  california: "CA",
  colorado: "CO",
