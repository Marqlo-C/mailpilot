      m43 = 0;
      m44 = 1;
      is2D = true;
      isIdentity = true;
      constructor() {}
      static fromMatrix() {
        return new DOMMatrixMock();
      }
      multiply() {
        return this;
      }
      translate() {
        return this;
      }
      scale() {
        return this;
      }
      rotate() {
        return this;
      }
      transformPoint(point: unknown) {
